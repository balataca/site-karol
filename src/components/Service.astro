---
import type { Icon as IconType } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  icon: typeof IconType;
}

const { title, description, icon: Icon } = Astro.props;
---

<div class="bg-white rounded-3xl p-8 shadow-lg hover:shadow-xl transition-shadow">
  <div class="w-16 h-16 bg-[#eef4ed] rounded-2xl flex items-center justify-center mb-6">
    <Icon class="w-8 h-8 text-[#134074]" stroke-width="2" />
  </div>
  <h3 class="text-2xl font-bold text-gray-800 mb-4">{title}</h3>
  <p class="text-gray-600 leading-relaxed">
    {description}
  </p>
</div>

