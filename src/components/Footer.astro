---
import { Mail } from '@lucide/astro';
import { getTranslations } from '../i18n/translations';

const locale = Astro.currentLocale || 'en';
const t = getTranslations(locale);
---
<footer class="bg-[#134074] text-white py-12 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-2xl font-bold mb-4">Karol Biscardi</h3>
        <p class="text-gray-300 leading-relaxed">
          {t('footer.description')}
        </p>
      </div>
      
      <div>
        <h4 class="text-lg font-semibold mb-4">{t('footer.quickLinks')}</h4>
        <ul class="space-y-2">
          <li><a href="#social" class="text-gray-300 hover:text-white transition-colors">{t('nav.social')}</a></li>
          <li><a href="#services" class="text-gray-300 hover:text-white transition-colors">{t('nav.services')}</a></li>
          <li><a href="#testimonials" class="text-gray-300 hover:text-white transition-colors">{t('nav.testimonials')}</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="text-lg font-semibold mb-4">{t('footer.contact')}</h4>
        <div class="space-y-2 text-gray-300">
          <div class="flex flex-col gap-2">
            <a href={`mailto:${t('footer.emailValue')}`} class="hover:text-white transition-colors">
              {t('footer.email')}: {t('footer.emailValue')}
            </a>
            <a href={`tel:${t('footer.phoneValue')}`} class="hover:text-white transition-colors">
              {t('footer.phone')}: {t('footer.phoneValue')}
            </a>
          </div>
          <div class="flex gap-4">
            <a
              href={`https://wa.me/5537998300122?text=${encodeURIComponent(t('whatsappMessage'))}`}
              target="_blank"
              class="hover:text-white transition-colors" aria-label="WhatsApp"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </a>
            <a href="https://linkedin.com/in/karolbiscardi" class="hover:text-white transition-colors" aria-label="LinkedIn">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
            <a href="mailto:karolbiscardi@gmail.com" class="hover:text-white transition-colors" aria-label="Email">
              <Mail class="w-6 h-6" />
            </a>
          </div>
        </div>
      </div>
    </div>
    
    <div class="border-t border-gray-500 pt-8 text-center text-gray-300">
      <p>&copy; {new Date().getFullYear()} Karol Biscardi. {t('footer.copyright')}</p>
    </div>
  </div>
</footer>

