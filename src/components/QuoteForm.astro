---
import { getTranslations } from '../i18n/translations';

const locale = Astro.currentLocale || 'en';
const t = getTranslations(locale);
---
<section id="quote" class="py-20 bg-gradient-to-br from-[#134074] to-[#8da9c4] px-4">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4 drop-shadow-lg">
        {t('quote.title')}
      </h2>
      <p class="text-xl text-white/90 drop-shadow-md">
        {t('quote.subtitle')}
      </p>
    </div>

    <form class="bg-white rounded-3xl p-8 md:p-12 shadow-xl" method="POST" action="#">
      <div class="space-y-6">
        <div>
          <label for="name" class="block text-gray-700 font-semibold mb-2">{t('quote.form.name')}</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required
            class="w-full px-6 py-4 rounded-2xl border-2 border-[#8da9c4] focus:border-[#134074] focus:outline-none transition-colors text-gray-800"
            placeholder={t('quote.form.namePlaceholder')}
          />
        </div>

        <div>
          <label for="email" class="block text-gray-700 font-semibold mb-2">{t('quote.form.email')}</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required
            class="w-full px-6 py-4 rounded-2xl border-2 border-[#8da9c4] focus:border-[#134074] focus:outline-none transition-colors text-gray-800"
            placeholder={t('quote.form.emailPlaceholder')}
          />
        </div>

        <div>
          <label for="phone" class="block text-gray-700 font-semibold mb-2">{t('quote.form.phone')}</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone"
            class="w-full px-6 py-4 rounded-2xl border-2 border-[#8da9c4] focus:border-[#134074] focus:outline-none transition-colors text-gray-800"
            placeholder={t('quote.form.phonePlaceholder')}
          />
        </div>

        <div>
          <label for="languages" class="block text-gray-700 font-semibold mb-2">{t('quote.form.languages')}</label>
          <input 
            type="text" 
            id="languages" 
            name="languages" 
            required
            class="w-full px-6 py-4 rounded-2xl border-2 border-[#8da9c4] focus:border-[#134074] focus:outline-none transition-colors text-gray-800"
            placeholder={t('quote.form.languagesPlaceholder')}
          />
        </div>

        <div>
          <label for="message" class="block text-gray-700 font-semibold mb-2">{t('quote.form.message')}</label>
          <textarea 
            id="message" 
            name="message" 
            rows="5"
            required
            class="w-full px-6 py-4 rounded-2xl border-2 border-[#8da9c4] focus:border-[#134074] focus:outline-none transition-colors text-gray-800 resize-none"
            placeholder={t('quote.form.messagePlaceholder')}
          ></textarea>
        </div>

        <button 
          type="submit"
          class="w-full bg-[#134074] text-white px-8 py-4 rounded-2xl text-lg font-semibold hover:bg-[#0b2545] transition-colors shadow-lg hover:shadow-xl"
        >
          {t('quote.form.submit')}
        </button>
      </div>
    </form>
  </div>
</section>

