---
import { Star } from '@lucide/astro';

interface Props {
  quote: string;
  name: string;
  initials: string;
  role: string;
}

const { quote, name, initials, role } = Astro.props;
---

<div class="flex flex-col justify-between bg-white rounded-3xl p-8 shadow-lg">
  <div>
    <div class="flex items-center mb-4 text-yellow-400">
      <Star class="w-5 h-5" fill="currentColor" />
      <Star class="w-5 h-5" fill="currentColor" />
      <Star class="w-5 h-5" fill="currentColor" />
      <Star class="w-5 h-5" fill="currentColor" />
      <Star class="w-5 h-5" fill="currentColor" />
    </div>
    <p class="text-gray-700 mb-6 leading-relaxed italic">
      "{quote}"
    </p>
  </div>
  <div class="flex items-center">
    <div class="w-12 h-12 bg-[#eef4ed] rounded-full flex items-center justify-center mr-4">
      <span class="text-[#134074] font-semibold text-lg">{initials}</span>
    </div>
    <div>
      <p class="font-semibold text-gray-800">{name}</p>
      <p class="text-sm text-gray-600">{role}</p>
    </div>
  </div>
</div>

